<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="cs625_preview">

  <!-- preview-only top-level robot description -->

  <xacro:arg name="name" default="cs625_preview"/>
  <xacro:include filename="$(find eli_cs_robot_description)/urdf/cs_macro_preview.xacro"/>

  <!-- possible values: cs63, cs66, cs612, cs616, cs620, cs625 -->
  <xacro:arg name="cs_type" default="cs625"/>

  <!-- parameters -->
  <xacro:arg name="joint_limit_params" default="$(find eli_cs_robot_description)/config/$(arg cs_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find eli_cs_robot_description)/config/$(arg cs_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find eli_cs_robot_description)/config/$(arg cs_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find eli_cs_robot_description)/config/$(arg cs_type)/visual_parameters.yaml"/>
  <xacro:arg name="safety_limits" default="false"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>

  <!-- create link fixed to the world -->
  <link name="world" />

  <!-- preview arm -->
  <xacro:cs_robot_preview
    name="$(arg name)"
    parent="world"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:cs_robot_preview>

  <!-- preview EEF -->
  <link name="preview_my_end_effector_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://eli_cs_robot_description/meshes/visual/tool0_vision.STL"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="preview_eef_color">
        <color rgba="0.20 0.70 1.00 0.75"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://eli_cs_robot_description/meshes/visual/tool0_collision.STL"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="preview_flange_to_eef_joint" type="fixed">
    <parent link="preview_flange"/>
    <child link="preview_my_end_effector_link"/>
    <origin xyz="-0.046 0 0.353" rpy="0 0 0"/>
  </joint>

</robot>
