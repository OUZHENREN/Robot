<?xml version="1.0"?>
<package format="3">
  <name>cs625_nbv</name>
  <version>0.0.1</version>
  <description>PoseGain-NBV: Reachability-aware next-best-view planning for CS625 robot arm</description>

  <maintainer email="yff@example.com">Yang Feifan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Interface generation -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- ROS2 core -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>action_msgs</depend>

  <!-- Eigen (linear algebra) -->
  <depend>eigen</depend>

  <!-- PCL (point cloud processing) -->
  <depend>libpcl-all-dev</depend>

  <!-- TF2 -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_eigen</depend>

  <!-- Existing workspace packages used as clients -->
  <depend>cs625_kinematics</depend>
  <depend>cs625_state_monitor</depend>
  <depend>pointcloud_workflow_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
