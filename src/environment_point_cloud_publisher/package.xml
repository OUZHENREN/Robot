<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>environment_point_cloud_publisher</name>
  <version>0.0.1</version>
  <description>
    Load environment point clouds from timestamped subdirectories, merge them,
    filter and optimize the combined cloud, and publish the resulting PointCloud2
    message with automatic directory rescanning and workflow service control.
  </description>

  <maintainer email="1933825889@qq.com">yff</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>pointcloud_workflow_interfaces</depend>
  <depend>eigen</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
